{
  "ConnectionStrings": {
    "QepDatabase": "<user-secrets: Host=localhost;Port=5432;Database=qep;Username=qep;Password=...>"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenTelemetry": {
    "Endpoint": "http://localhost:4317"
  },
  "Authentication": {
    "UseDevelopmentStub": false,
    "Authority": "https://accounts.google.com",
    "Audience": "",
    "Google": {
      "ClientId": "<user-secrets: google-oauth-client-id>"
    },
    "Session": {
      "CookieName": "qep_session",
      "AbsoluteLifetimeDays": 30,
      "IdleTimeoutDays": 7
    }
  },
  "Registration": {
    "PublicTenantSignupEnabled": true
  },
  "Notifications": {
    "EmailProvider": "log",
    "InvitationUrl": "http://localhost:3002/invitations",
    "Infobip": {
      "BaseUrl": "<user-secrets: https://xxxxx.api.infobip.com>",
      "ApiKey": "<user-secrets: infobip-api-key>",
      "SenderEmail": "noreply@example.com"
    }
  },
  "Audit": {
    "SecurityRetentionDays": 2555,
    "OperationalRetentionDays": 730
  },
  "Storage": {
    "PresignedUrlMinutes": 5,
    "ExportUrlHours": 24,
    "StagingRetentionHours": 24,
    "StagingCleanupMinutes": 60,
    "R2": {
      "AccountId": "<user-secrets: cloudflare-account-id>",
      "AccessKeyId": "<user-secrets: r2-access-key-id>",
      "SecretAccessKey": "<user-secrets: r2-secret-access-key>",
      "Bucket": "<user-secrets: bucket-privado>",
      "Endpoint": "",
      "PublicBucket": "",
      "PublicBaseUrl": ""
    },
    "ClamAv": {
      "Enabled": false,
      "Host": "clamav",
      "Port": 3310,
      "TimeoutSeconds": 30
    }
  },
  "Quotations": {
    "ExpirationSweepMinutes": 60,
    "WhatsApp": {
      "ApiToken": "<user-secrets: zenvia-api-token>",
      "FromNumber": "<user-secrets: zenvia-from-number>",
      "TemplateId": "72695acd-639b-49b4-8d6f-ad2ce3ad01a3",
      "DocumentUrlHours": 24,
      "BaseUrl": "https://api.zenvia.com"
    }
  }
}
