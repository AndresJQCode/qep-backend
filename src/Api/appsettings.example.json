{
  "ConnectionStrings": {
    "QepDatabase": "<user-secrets: Host=localhost;Port=5432;Database=qep;Username=qep;Password=...>",
    "Valkey": "<user-secrets: localhost:6379>"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ForwardedHeaders": {
    "KnownNetworks": []
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "OpenTelemetry": {
    "Endpoint": "http://localhost:4317"
  },
  "Deployment": {
    "BuildId": "<k8s configMap: #{Build.BuildId}#, el tag de la imagen; en local se deja sin valor>",
    "BuildNumber": "<k8s configMap: #{Build.BuildNumber}#>",
    "Commit": "<k8s configMap: #{Build.SourceVersion}#>"
  },
  "Authentication": {
    "UseDevelopmentStub": false,
    "Authority": "https://accounts.google.com",
    "Audience": "",
    "Google": {
      "ClientId": "<user-secrets: google-oauth-client-id>"
    },
    "Session": {
      "CookieName": "qep_session",
      "AbsoluteLifetimeDays": 30,
      "IdleTimeoutDays": 7
    }
  },
  "Registration": {
    "PublicTenantSignupEnabled": true
  },
  "Entitlements": {
    "GrantDefaultModulesOnSignup": true
  },
  "Platform": {
    "OperatorTenantId": "01900000-0000-7000-8000-000000000006"
  },
  "Seed": {
    "Enabled": false,
    "OwnerEmail": "<env: email que recibe el rol admin del tenant sembrado>",
    "OperatorOwnerEmail": "<env: email de QCode que recibe el rol admin del tenant operador; sin valor no se crea>",
    "ExportLoad": {
      "Quotations": 0
    }
  },
  "Notifications": {
    "EmailProvider": "log",
    "InvitationUrl": "http://localhost:3002/invitations",
    "AppBaseUrl": "http://localhost:3002",
    "InApp": {
      "RetentionDays": 90
    },
    "TaskNotice": {
      "EscalationAfterMinutes": 30
    },
    "Infobip": {
      "BaseUrl": "<user-secrets: https://xxxxx.api.infobip.com>",
      "ApiKey": "<user-secrets: infobip-api-key>",
      "SenderEmail": "noreply@example.com"
    }
  },
  "Audit": {
    "SecurityRetentionDays": 2555,
    "OperationalRetentionDays": 730
  },
  "Storage": {
    "PresignedUrlMinutes": 5,
    "ExportUrlHours": 24,
    "StagingRetentionHours": 24,
    "StagingCleanupMinutes": 60,
    "PaymentProofOrphanCleanup": {
      "MinimumAgeHours": 24,
      "IntervalHours": 24,
      "DryRun": true
    },
    "R2": {
      "AccountId": "<user-secrets: cloudflare-account-id>",
      "AccessKeyId": "<user-secrets: r2-access-key-id>",
      "SecretAccessKey": "<user-secrets: r2-secret-access-key>",
      "Bucket": "<user-secrets: bucket-privado>",
      "Endpoint": "",
      "PublicBucket": "",
      "PublicBaseUrl": ""
    },
    "ClamAv": {
      "Enabled": false,
      "Host": "clamav",
      "Port": 3310,
      "TimeoutSeconds": 30
    }
  },
  "Hr": {
    "SweepMinutes": 15,
    "SendHourLocal": 8
  },
  "Loans": {
    "SweepMinutes": 15
  },
  "Store": {
    "RootDomain": "lulocrm.com",
    "DailyRequestCap": 500,
    "Storefront": {
      "SharedSecret": "<user-secrets: Store__Storefront__SharedSecret, at least 32 characters>"
    },
    "Turnstile": {
      "Enabled": true,
      "SecretKey": "<user-secrets: Store__Turnstile__SecretKey>",
      "VerifyUrl": "https://challenges.cloudflare.com/turnstile/v0/siteverify"
    }
  },
  "Quotations": {
    "ExpirationSweepMinutes": 60,
    "WhatsApp": {
      "DocumentUrlHours": 24,
      "BaseUrl": "https://api.zenvia.com"
    },
    "Pdf": {
      "BaseUrl": "https://qcode-pdf.qcode.co",
      "ApiKey": "<user-secrets: qcode-pdf-api-key>"
    },
    "PaymentProofs": {
      "PublicLinks": false
    }
  },
  "Integrations": {
    "SecretProtection": {
      "ActiveKeyId": "",
      "Keys": {},
      "RekeyIntervalMinutes": 60
    },
    "Zenvia": {
      "BaseUrl": "https://api.zenvia.com"
    },
    "Instagram": {
      "RefreshIntervalMinutes": 1440,
      "RefreshBeforeExpiryDays": 15
    }
  },
  "Meta": {
    "App": {
      "AppId": "1234567890",
      "ConfigId": "9876543210",
      "GraphApiVersion": "v24.0",
      "AppSecret": "<user-secrets: Meta:App:AppSecret>",
      "WebhookVerifyToken": "<user-secrets: Meta:App:WebhookVerifyToken, aleatorio de 32+ caracteres>",
      "WebhookOverrideCallbackUrl": ""
    },
    "Instagram": {
      "AppId": "<el Instagram App ID del caso de uso Instagram, distinto del de la app>",
      "AppSecret": "<user-secrets: Meta:Instagram:AppSecret>",
      "GraphApiVersion": "v24.0",
      "AllowedRedirectOrigins": ["http://localhost:3002"]
    }
  },
  "Shopify": {
    "App": {
      "ClientId": "<el Client ID de la app en el Dev Dashboard de Shopify; local: user-secrets Shopify:App:ClientId>",
      "ClientSecret": "<user-secrets: Shopify:App:ClientSecret; en k8s, prod-secret.yaml, nunca el ConfigMap>",
      "ApiVersion": "2026-10",
      "Scopes": "read_orders,write_orders,read_customers",
      "AllowedRedirectOrigins": ["http://localhost:3002"],
      "WebhookCallbackUrl": "https://qep-api.qcode.co/api/webhooks/shopify"
    },
    "Webhook": {
      "MaxBodyBytes": 1048576,
      "DeliveryPollSeconds": 15
    },
    "Reconcile": {
      "IntervalMinutes": 10
    }
  },
  "Siigo": {
    "BaseUrl": "https://api.siigo.com",
    "PartnerId": "<el Partner-Id de QEP ante Siigo: 3 a 100 caracteres alfanuméricos, sin espacios>",
    "Batches": {
      "PollSeconds": 5
    }
  },
  "Messaging": {
    "Webhook": {
      "MaxBodyBytes": 4194304,
      "ConcurrencyLimit": 64,
      "QueueLimit": 256
    },
    "Workers": {
      "DeliveryPollSeconds": 3,
      "MediaPollSeconds": 5,
      "CampaignPollSeconds": 10,
      "ScheduledPollSeconds": 5,
      "PurgeIntervalHours": 24,
      "DeliveryRetentionDays": 7
    },
    "Search": {
      "StatementTimeoutMs": 2000
    },
    "Campaigns": {
      "MessagesPerSecond": 20,
      "MaxMessagesPerSecond": 80
    },
    "MarketingOptOut": {
      "ButtonTexts": [ "Detener promociones", "Stop promotions" ]
    },
    "Automation": {
      "Enqueue": true
    }
  },
  "ApiAccess": {
    "RateLimit": {
      "PerKeyPerMinute": 300,
      "PerIpPerMinute": 600
    }
  },
  "Valkey": {
    "Enabled": false,
    "Areas": {
      "Presence": false,
      "RateLimiting": false,
      "Sessions": false,
      "Permissions": false,
      "SendBudget": false,
      "Doorbells": false,
      "ApiKeyTouch": false,
      "LegalParameters": false
    },
    "OperationTimeoutMs": 100
  },
  "Ai": {
    "DefaultProvider": "anthropic",
    "Model": {
      "MaxOutputTokens": 16000,
      "CallTimeoutSeconds": 45,
      "JobTimeoutSeconds": 120,
      "MaxModelCalls": 6,
      "MaxToolCalls": 8,
      "MaxHistoryTurns": 30,
      "MaxContextTokens": null
    },
    "Workers": {
      "PollSeconds": 1,
      "BatchSize": 10,
      "LeaseMinutes": 3,
      "DebounceSeconds": 2,
      "IdleHours": 24,
      "IdleSweepMinutes": 10,
      "ModuleSweepSeconds": 60,
      "CopilotRetentionSweepHours": 24,
      "Enabled": true
    },
    "Copilot": {
      "MessagesPerHour": 30,
      "MessagesPerDay": 200,
      "MaxOutputTokens": 16000,
      "MaxModelCalls": 8,
      "MaxToolCalls": 12,
      "JobTimeoutSeconds": 120,
      "MaxHistoryMessages": 20,
      "MaxContextTokens": null,
      "ToolCallRetentionDays": 30
    },
    "Providers": {
      "anthropic": {
        "Models": [
          {
            "Id": "claude-opus-5-5",
            "Label": "Claude Opus 5.5",
            "Description": "El más capaz de Anthropic. Para conversaciones con varios pasos o herramientas.",
            "IsDefault": true,
            "Available": true,
            "Effort": "medium"
          },
          {
            "Id": "claude-sonnet-5-5",
            "Label": "Claude Sonnet 5.5",
            "Description": "Equilibrio entre calidad, velocidad y costo.",
            "IsDefault": false,
            "Available": true,
            "Effort": "medium"
          },
          {
            "Id": "claude-haiku-5-5",
            "Label": "Claude Haiku 5.5",
            "Description": "El más rápido y económico, para preguntas sencillas.",
            "IsDefault": false,
            "Available": true,
            "Effort": "medium"
          }
        ]
      },
      "openai": {
        "Models": [
          {
            "Id": "gpt-6-luna",
            "Label": "GPT-6 Luna",
            "Description": "El más eficiente de OpenAI, para conversaciones acotadas de alto volumen.",
            "IsDefault": true,
            "Available": true
          },
          {
            "Id": "gpt-6.1-terra",
            "Label": "GPT-6.1 Terra",
            "Description": "Rápido y eficiente, con escritura natural. Equilibrio entre costo y calidad.",
            "IsDefault": false,
            "Available": true
          },
          {
            "Id": "gpt-6.1-sol",
            "Label": "GPT-6.1 Sol",
            "Description": "Cercano al tope de gama a menor costo, para instrucciones o herramientas complejas.",
            "IsDefault": false,
            "Available": true
          }
        ]
      }
    }
  },
  "Automations": {
    "Workers": {
      "InboxPollSeconds": 1,
      "InboxBatchSize": 20,
      "AbandonSweepMinutes": 10,
      "InboxRetentionDays": 7,
      "HttpCallRetentionDays": 30,
      "RunDetailRetentionDays": 3,
      "SimulationSweepMinutes": 10
    }
  },
  "Support": {
    "Workers": {
      "FollowIntervalSeconds": 5,
      "BatchSize": 200,
      "FeedLookbackHours": 24,
      "SurveyIntervalSeconds": 30,
      "SurveyBatchSize": 5,
      "SurveyCommentWindowHours": 24,
      "SurveyAnswerLookbackDays": 14,
      "AutoCloseIntervalMinutes": 15,
      "UnassignedAlertIntervalMinutes": 5
    },
    "PublicForm": {
      "BaseUrl": "https://soporte.lulocrm.com",
      "Hostname": "soporte.lulocrm.com",
      "AllowedOrigins": ["http://localhost:4322"]
    },
    "Pdf": {
      "BaseUrl": "https://qcode-pdf.qcode.co",
      "ApiKey": "<user-secrets: la clave de qcode-pdf de Soporte, nunca la de Quotations>",
      "TimeoutSeconds": 30
    }
  },
  "Purchases": {
    "Pdf": {
      "BaseUrl": "https://qcode-pdf.qcode.co",
      "ApiKey": "<user-secrets: la clave de qcode-pdf de Compras, nunca la de Quotations ni la de Support>",
      "TimeoutSeconds": 30
    }
  },
  "Scheduling": {
    "Workers": {
      "ReminderPollSeconds": 60
    }
  }
}
