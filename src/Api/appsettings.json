{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Platform": {
    "OperatorTenantId": "01900000-0000-7000-8000-000000000006"
  },
  "Registration": {
    "PublicTenantSignupEnabled": true
  },
  "Notifications": {
    "EmailProvider": "log",
    "InvitationUrl": "http://localhost:3002/invitations",
    "AppBaseUrl": "http://localhost:3002",
    "Infobip": {
      "SenderEmail": "noreply@mail.lulocrm.com"
    }
  },
  "Audit": {
    "SecurityRetentionDays": 2555,
    "OperationalRetentionDays": 730
  },
  "Storage": {
    "PresignedUrlMinutes": 5,
    "ExportUrlHours": 24,
    "StagingRetentionHours": 24,
    "StagingCleanupMinutes": 60,
    "PaymentProofOrphanCleanup": {
      "MinimumAgeHours": 24,
      "IntervalHours": 24,
      "DryRun": true
    },
    "ClamAv": {
      "Enabled": false,
      "Host": "clamav",
      "Port": 3310,
      "TimeoutSeconds": 30
    }
  },
  "Quotations": {
    "ExpirationSweepMinutes": 60,
    "PaymentProofs": {
      "PublicLinks": false
    }
  },
  "Billing": {
    "SweepMinutes": 15,
    "SendHourLocal": 8
  },
  "Hr": {
    "SweepMinutes": 15,
    "SendHourLocal": 8
  },
  "Loans": {
    "SweepMinutes": 15
  },
  "Wms": {
    "Workers": {
      "BalanceChangePublishSeconds": 10,
      "ReconciliationHourUtc": 3,
      "ReconciliationSweepMinutes": 30,
      "PartitionSweepHours": 24,
      "HousekeepingHours": 24,
      "ReceiptRetentionDays": 45,
      "PreviewRetentionMinutes": 30,
      "TaskLeaseSweepSeconds": 60
    }
  },
  "Store": {
    "RootDomain": "lulocrm.com",
    "DailyRequestCap": 500,
    "Turnstile": {
      "Enabled": true,
      "VerifyUrl": "https://challenges.cloudflare.com/turnstile/v0/siteverify"
    }
  },
  "Meta": {
    "Instagram": {
      "AllowedRedirectOrigins": ["http://localhost:3002"]
    }
  },
  "Messaging": {
    "Automation": {
      "Enqueue": true
    }
  },
  "Ai": {
    "DefaultProvider": "anthropic",
    "Copilot": {
      "MessagesPerHour": 30,
      "MessagesPerDay": 200,
      "MaxOutputTokens": 16000,
      "MaxModelCalls": 8,
      "MaxToolCalls": 12,
      "JobTimeoutSeconds": 120,
      "MaxHistoryMessages": 20,
      "ToolCallRetentionDays": 30
    },
    "Providers": {
      "anthropic": {
        "Models": [
          {
            "Id": "claude-opus-5-5",
            "Label": "Claude Opus 5.5",
            "Description": "El más capaz de Anthropic. Para conversaciones con varios pasos o herramientas.",
            "IsDefault": true,
            "Available": true,
            "Effort": "medium"
          },
          {
            "Id": "claude-sonnet-5-5",
            "Label": "Claude Sonnet 5.5",
            "Description": "Equilibrio entre calidad, velocidad y costo.",
            "IsDefault": false,
            "Available": true,
            "Effort": "medium"
          },
          {
            "Id": "claude-haiku-5-5",
            "Label": "Claude Haiku 5.5",
            "Description": "El más rápido y económico, para preguntas sencillas.",
            "IsDefault": false,
            "Available": true,
            "Effort": "medium"
          }
        ]
      },
      "openai": {
        "Models": [
          {
            "Id": "gpt-6-luna",
            "Label": "GPT-6 Luna",
            "Description": "El más eficiente de OpenAI, para conversaciones acotadas de alto volumen.",
            "IsDefault": true,
            "Available": true
          },
          {
            "Id": "gpt-6.1-terra",
            "Label": "GPT-6.1 Terra",
            "Description": "Rápido y eficiente, con escritura natural. Equilibrio entre costo y calidad.",
            "IsDefault": false,
            "Available": true
          },
          {
            "Id": "gpt-6.1-sol",
            "Label": "GPT-6.1 Sol",
            "Description": "Cercano al tope de gama a menor costo, para instrucciones o herramientas complejas.",
            "IsDefault": false,
            "Available": true
          }
        ]
      }
    }
  },
  "Automations": {
    "Workers": {
      "InboxPollSeconds": 1,
      "InboxBatchSize": 20,
      "AbandonSweepMinutes": 10,
      "InboxRetentionDays": 7,
      "HttpCallRetentionDays": 30,
      "SimulationSweepMinutes": 10
    }
  },
  "Support": {
    "Workers": {
      "FollowIntervalSeconds": 5,
      "BatchSize": 200
    },
    "PublicForm": {
      "BaseUrl": "https://soporte.lulocrm.com",
      "Hostname": "soporte.lulocrm.com",
      "AllowedOrigins": []
    },
    "Pdf": {
      "BaseUrl": "https://qcode-pdf.qcode.co"
    }
  },
  "Purchases": {
    "Pdf": {
      "BaseUrl": "https://qcode-pdf.qcode.co"
    }
  },
  "Shopify": {
    "App": {
      "ApiVersion": "2026-10",
      "Scopes": "read_orders,write_orders,read_customers"
    },
    "Reconcile": {
      "IntervalMinutes": 10
    }
  },
  "AllowedHosts": "*"
}
