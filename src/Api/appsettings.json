{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Platform": {
    "OperatorTenantId": "01900000-0000-7000-8000-000000000006"
  },
  "Registration": {
    "PublicTenantSignupEnabled": true
  },
  "Notifications": {
    "EmailProvider": "log",
    "InvitationUrl": "http://localhost:3002/invitations",
    "Infobip": {
      "SenderEmail": "noreply@mail.lulocrm.com"
    }
  },
  "Audit": {
    "SecurityRetentionDays": 2555,
    "OperationalRetentionDays": 730
  },
  "Storage": {
    "PresignedUrlMinutes": 5,
    "ExportUrlHours": 24,
    "StagingRetentionHours": 24,
    "StagingCleanupMinutes": 60,
    "PaymentProofOrphanCleanup": {
      "MinimumAgeHours": 24,
      "IntervalHours": 24,
      "DryRun": true
    },
    "ClamAv": {
      "Enabled": false,
      "Host": "clamav",
      "Port": 3310,
      "TimeoutSeconds": 30
    }
  },
  "Quotations": {
    "ExpirationSweepMinutes": 60,
    "PaymentProofs": {
      "PublicLinks": false
    }
  },
  "Meta": {
    "Instagram": {
      "AllowedRedirectOrigins": ["http://localhost:3002"]
    }
  },
  "Messaging": {
    "Automation": {
      "Enqueue": true
    }
  },
  "Automations": {
    "Workers": {
      "InboxPollSeconds": 1,
      "InboxBatchSize": 20,
      "AbandonSweepMinutes": 10,
      "HttpCallRetentionDays": 30,
      "SimulationSweepMinutes": 10
    }
  },
  "Shopify": {
    "App": {
      "ApiVersion": "2026-10",
      "Scopes": "read_orders,read_customers"
    },
    "Reconcile": {
      "IntervalMinutes": 10
    }
  },
  "AllowedHosts": "*"
}
