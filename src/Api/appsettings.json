{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpenTelemetry": {
    "Endpoint": "http://localhost:4317"
  },
  "Registration": {
    "PublicTenantSignupEnabled": true
  },
  "Notifications": {
    "EmailProvider": "infobip",
    "InvitationUrl": "http://localhost:3002/invitations",
    "Infobip": {
      "SenderEmail": "noreply@mail.lulocrm.com"
    }
  },
  "Audit": {
    "SecurityRetentionDays": 2555,
    "OperationalRetentionDays": 730
  },
  "Storage": {
    "PresignedUrlMinutes": 5,
    "ExportUrlHours": 24,
    "StagingRetentionHours": 24,
    "StagingCleanupMinutes": 60,
    "ClamAv": {
      "Enabled": false,
      "Host": "clamav",
      "Port": 3310,
      "TimeoutSeconds": 30
    }
  },
  "Quotations": {
    "ExpirationSweepMinutes": 60,
    "WhatsApp": {
      "TemplateId": "90594f03-8f6c-46c0-9710-1cf2cbc2de6c"
    }
  },
  "AllowedHosts": "*"
}
