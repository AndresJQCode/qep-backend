<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- BackgroundService y ILogger salen del shared framework, como en Pipeline (el worker del motor llega en el plan 2). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Modules.Automations.Application\Modules.Automations.Application.csproj" />
    <ProjectReference Include="..\Modules.Automations.Domain\Modules.Automations.Domain.csproj" />
    <ProjectReference Include="..\..\Audit\Modules.Audit.Domain\Modules.Audit.Domain.csproj" />
    <ProjectReference Include="..\..\Audit\Modules.Audit.Infrastructure\Modules.Audit.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Tenancy\Modules.Tenancy.Application\Modules.Tenancy.Application.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\BuildingBlocks.Application\BuildingBlocks.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>
  <ItemGroup>
    <!-- Spec 2026-10-21 D-C8: las plantillas del sistema viajan dentro del ensamblado, como los seeds de Geografía y Catálogo. -->
    <EmbeddedResource Include="Seed\Templates\*.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- Las corridas, las llamadas HTTP y las simulaciones son registros internal; las pruebas los buscan en el host. -->
    <InternalsVisibleTo Include="Modules.Automations.UnitTests" />
    <InternalsVisibleTo Include="Modules.Automations.IntegrationTests" />
  </ItemGroup>
</Project>
