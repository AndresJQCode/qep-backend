<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- IQuotationExpirationProcessor es internal: no es API pública del módulo, pero las
         pruebas de integración lo invocan directo (US-19) para no depender del temporizador de
         QuotationExpirationWorker. -->
    <InternalsVisibleTo Include="Modules.Quotations.IntegrationTests" />
    <InternalsVisibleTo Include="Modules.Quotations.UnitTests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Modules.Quotations.Application\Modules.Quotations.Application.csproj" />
    <ProjectReference Include="..\Modules.Quotations.Domain\Modules.Quotations.Domain.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\BuildingBlocks.Application\BuildingBlocks.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>
  <ItemGroup>
    <!-- La plantilla es parte del contrato con `qcode-pdf`, no configuracion: viaja adentro
         del ensamblado para que no se pierda al publicar la imagen. -->
    <EmbeddedResource Include="Pdf\quotation.typ" />
    <!-- El logo del membrete es configuración de despliegue, no dato de tenant —igual que
         `VITE_TENANT_BRAND_LOGO` del frontend: una sola imagen para todos los tenants de esta
         instalación. Viaja embebida por el mismo motivo que la plantilla: `qcode-pdf` sólo
         recibe `source` y `data`, así que el renderer la manda en base64 dentro de `data`. -->
    <EmbeddedResource Include="Pdf\tenant-logo.webp" />
  </ItemGroup>
</Project>
