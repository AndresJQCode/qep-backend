<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- Lo que sólo se prueba contra PostgreSQL necesita Docker: el SQL entre esquemas de los adaptadores
         (CatalogVariantUsageCheckerTests, CustomerMergeReferencesTests, CustomerReferenceWritesTests) y los
         advisory locks (CustomerReferenceLockTests y StartupLockTests, el candado de arranque). -->
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- Los adaptadores entre módulos y los validadores de opciones del composition root son
         internal (InternalsVisibleTo en Bootstrapper.csproj). Los módulos llegan transitivos por
         esta referencia. -->
    <ProjectReference Include="..\..\..\src\Bootstrapper\Bootstrapper.csproj" />
    <!-- BuyerParityTests ata el header de sesión de Store.Api al de Buyers.Api (que trae Store.Api transitivo). -->
    <ProjectReference Include="..\..\..\src\Modules\Buyers\Modules.Buyers.Api\Modules.Buyers.Api.csproj" />
    <!-- SupportPublicPathsTests ata el prefijo y la política CORS de Bootstrapper al grupo público de Support.Api. -->
    <ProjectReference Include="..\..\..\src\Modules\Support\Modules.Support.Api\Modules.Support.Api.csproj" />
  </ItemGroup>
</Project>
