{
  "schema": 1,
  "start": { "firstNodeId": "welcome" },
  "variables": [
    { "name": "cedula", "type": "text" },
    { "name": "cliente", "type": "object" },
    { "name": "equipos", "type": "list" },
    { "name": "equipo", "type": "object" },
    { "name": "motivo", "type": "object" },
    { "name": "fallas", "type": "list" },
    { "name": "falla", "type": "object" },
    { "name": "contacto", "type": "text" },
    { "name": "telefonoContacto", "type": "text" },
    { "name": "servicioId", "type": "number" },
    { "name": "ordenId", "type": "number" },
    { "name": "nombreCompleto", "type": "text" },
    { "name": "direccion", "type": "text" },
    { "name": "fallaDescrita", "type": "text" },
    { "name": "factura", "type": "attachment" },
    { "name": "numeroSolicitud", "type": "text" }
  ],
  "nodes": [
    { "id": "welcome", "kind": "message", "title": "Bienvenida", "text": "Hola {nombre}, bienvenido a Clasic. Te ayudamos a programar el servicio de tu calentador.", "outputs": { "next": "document" } },
    { "id": "document", "kind": "openQuestion", "title": "Número de documento", "text": "Escribe tu número de documento, sin puntos ni espacios.", "saveTo": "cedula", "validation": { "kind": "digits" }, "outputs": { "answered": "find-customer", "invalid": null } },
    { "id": "find-customer", "kind": "http", "title": "Buscar cliente", "connectionId": "11111111-1111-1111-1111-111111111111", "method": "GET", "path": "/customers", "query": [ { "key": "identificationNumber", "value": "{cedula}" } ], "body": null, "timeoutSeconds": 8, "okWhen": [200], "mapping": [ { "from": "data[0]", "to": "cliente" } ], "sampleResponse": { "data": [ { "id": 7, "firstName": "Laura", "lastName": "Gómez", "acceptPolicy": true } ], "total": 1 }, "outputs": { "ok": "customer-found", "error": "handoff" } },
    { "id": "customer-found", "kind": "condition", "title": "¿Cliente encontrado?", "match": "all", "rules": [ { "variable": "cliente", "operator": "isNotEmpty" } ], "outputs": { "yes": "invoice-items", "no": "not-found" } },
    { "id": "not-found", "kind": "message", "title": "Usuario no encontrado", "text": "No encontramos ese documento. Puedes registrarte en la página o dejarnos tus datos por aquí.", "urlButton": { "label": "Registrarme", "url": "https://app.clasic.com.co/registro-clientes" }, "outputs": { "next": "not-found-options" } },
    { "id": "not-found-options", "kind": "buttons", "title": "¿Cómo seguimos?", "text": "¿Qué prefieres hacer?", "buttons": [ { "id": "leave", "label": "Dejar mis datos" }, { "id": "other-doc", "label": "Otro documento" } ], "saveTo": null, "fallback": "repeat", "outputs": { "leave": "new-name", "other-doc": "document", "other": null } },
    { "id": "new-name", "kind": "openQuestion", "title": "Nombre completo", "text": "¿Cuál es tu nombre completo?", "saveTo": "nombreCompleto", "validation": { "kind": "none" }, "outputs": { "answered": "new-address", "invalid": null } },
    { "id": "new-address", "kind": "openQuestion", "title": "Dirección", "text": "¿En qué dirección está el calentador? Incluye el barrio.", "saveTo": "direccion", "validation": { "kind": "none" }, "outputs": { "answered": "new-failure", "invalid": null } },
    { "id": "new-failure", "kind": "openQuestion", "title": "Falla del calentador", "text": "Cuéntanos qué calentador tienes y qué falla presenta.", "saveTo": "fallaDescrita", "validation": { "kind": "none" }, "outputs": { "answered": "invoice-photo", "invalid": null } },
    { "id": "invoice-photo", "kind": "attachment", "title": "Foto de la factura", "text": "Envíanos una foto o el PDF de la factura de compra.", "accept": "any", "saveTo": "factura", "outputs": { "received": "new-customer", "invalid": null } },
    { "id": "new-customer", "kind": "http", "title": "Registrar cliente", "connectionId": "11111111-1111-1111-1111-111111111111", "method": "POST", "path": "/customers/new-customer", "query": [], "body": { "kind": "multipart", "fields": [ { "key": "identificationNumber", "value": "{cedula}" }, { "key": "fullName", "value": "{nombreCompleto}" }, { "key": "address", "value": "{direccion}" }, { "key": "phone", "value": "{telefono}" }, { "key": "failureDescription", "value": "{fallaDescrita}" } ], "fileField": "file", "fileVariable": "factura" }, "timeoutSeconds": 10, "okWhen": null, "mapping": [ { "from": "serviceOrderNumber", "to": "numeroSolicitud" } ], "sampleResponse": { "serviceOrderNumber": "OS-123" }, "outputs": { "ok": "registered", "error": "handoff" } },
    { "id": "registered", "kind": "resolve", "title": "Datos recibidos", "text": "Recibimos tus datos. Tu solicitud es la {numeroSolicitud}." },
    { "id": "invoice-items", "kind": "http", "title": "Buscar equipos", "connectionId": "11111111-1111-1111-1111-111111111111", "method": "GET", "path": "/invoices/customer/{cliente.id}/all-invoice-items", "query": [], "body": null, "timeoutSeconds": 8, "okWhen": [200], "mapping": [ { "from": "$", "to": "equipos" } ], "sampleResponse": [ { "id": 1, "referenceCode": "CAL-001", "address": "Calle 1 # 2-3", "haveOrderOpen": false } ], "outputs": { "ok": "equipment", "error": "handoff" } },
    { "id": "equipment", "kind": "list", "title": "¿Cuál equipo?", "text": "Elige el equipo que necesita servicio.", "buttonLabel": "Ver equipos", "options": { "kind": "dynamic", "collection": "equipos", "idField": "id", "titleField": "referenceCode", "descriptionField": "address", "extraOption": { "id": "other", "title": "Otra dirección" } }, "saveTo": "equipo", "fallback": "repeat", "outputs": { "chosen": "service-kind", "extra": "new-address", "tooMany": "handoff", "other": null } },
    { "id": "service-kind", "kind": "buttons", "title": "¿Qué tipo de servicio?", "text": "¿Qué tipo de servicio necesitas?", "buttons": [ { "id": "tech", "label": "Servicio técnico" }, { "id": "maint", "label": "Mantenimiento" } ], "saveTo": "motivo", "fallback": "repeat", "outputs": { "tech": "failures", "maint": "maintenance-handoff", "other": null } },
    { "id": "failures", "kind": "http", "title": "Buscar fallas", "connectionId": "11111111-1111-1111-1111-111111111111", "method": "GET", "path": "/failures", "query": [], "body": null, "timeoutSeconds": 8, "okWhen": [200], "mapping": [ { "from": "$", "to": "fallas" } ], "sampleResponse": [ { "id": 3, "description": "No enciende" } ], "outputs": { "ok": "failure", "error": "handoff" } },
    { "id": "failure", "kind": "list", "title": "¿Qué falla tiene?", "text": "Elige la falla que presenta el calentador.", "buttonLabel": "Ver fallas", "options": { "kind": "dynamic", "collection": "fallas", "idField": "id", "titleField": "description", "descriptionField": null, "extraOption": null }, "saveTo": "falla", "fallback": "repeat", "outputs": { "chosen": "contact-name", "tooMany": "handoff", "other": null } },
    { "id": "contact-name", "kind": "openQuestion", "title": "Nombre de contacto", "text": "¿Con quién nos comunicamos para la visita?", "saveTo": "contacto", "validation": { "kind": "none" }, "outputs": { "answered": "contact-phone", "invalid": null } },
    { "id": "contact-phone", "kind": "openQuestion", "title": "Teléfono de contacto", "text": "¿A qué número lo llamamos? Escribe sólo los dígitos.", "saveTo": "telefonoContacto", "validation": { "kind": "digits" }, "outputs": { "answered": "service-type", "invalid": null } },
    { "id": "service-type", "kind": "http", "title": "Tipo de servicio", "connectionId": "11111111-1111-1111-1111-111111111111", "method": "GET", "path": "/service-orders/auto-select-service-type", "query": [ { "key": "invoiceItemId", "value": "{equipo.id}" } ], "body": null, "timeoutSeconds": 8, "okWhen": [200], "mapping": [ { "from": "id", "to": "servicioId" } ], "sampleResponse": { "id": 9, "name": "Servicio técnico" }, "outputs": { "ok": "create-order", "error": "handoff" } },
    { "id": "create-order", "kind": "http", "title": "Crear orden", "connectionId": "11111111-1111-1111-1111-111111111111", "method": "POST", "path": "/service-orders", "query": [], "body": { "kind": "json", "template": "{ \"customerId\": {cliente.id}, \"failureId\": {falla.item.id}, \"serviceId\": {servicioId}, \"invoiceItems\": [ { \"id\": \"{equipo.id}\", \"contact\": \"{contacto}\", \"optionalPhone\": \"{telefonoContacto}\", \"update\": true } ] }" }, "timeoutSeconds": 10, "okWhen": null, "mapping": [ { "from": "id", "to": "ordenId" } ], "sampleResponse": { "id": 55 }, "outputs": { "ok": "summary", "error": "order-error" } },
    { "id": "summary", "kind": "resolve", "title": "Resumen", "text": "Listo, {contacto}. Tu orden es la {ordenId}; te llamamos al {telefonoContacto} para agendar la visita." },
    { "id": "order-error", "kind": "message", "title": "No se pudo crear la orden", "text": "No pudimos crear la orden: puede que ya exista una abierta para esa dirección.", "outputs": { "next": "handoff" } },
    { "id": "maintenance-handoff", "kind": "handoff", "title": "Asesor de mantenimiento", "text": "Un asesor te escribe en un momento para agendar el mantenimiento." },
    { "id": "handoff", "kind": "handoff", "title": "Pasar a un asesor", "text": "Te paso con un asesor." }
  ]
}
