{
  "schema": 1,
  "start": { "firstNodeId": "n1" },
  "variables": [ { "name": "cedula", "type": "text" }, { "name": "equipos", "type": "list" } ],
  "nodes": [
    { "id": "n1", "kind": "message", "title": "Bienvenida", "text": "Hola {nombre}, bienvenido a la línea de servicio.", "urlButton": { "label": "Registrarme", "url": "https://www.example.com/registro" }, "outputs": { "next": "n2" } },
    { "id": "n2", "kind": "openQuestion", "title": "Número de documento", "text": "¿Cuál es tu número de documento?", "saveTo": "cedula", "validation": { "kind": "digits" }, "maxAttempts": 3, "outputs": { "answered": "n3", "invalid": null } },
    { "id": "n3", "kind": "http", "title": "Buscar cliente", "connectionId": "11111111-1111-1111-1111-111111111111", "method": "GET", "path": "/customers", "query": [ { "key": "identificationNumber", "value": "{cedula}" } ], "body": null, "timeoutSeconds": 8, "okWhen": [200], "mapping": [ { "from": "data[0]", "to": "cliente" } ], "sampleResponse": { "data": [] }, "outputs": { "ok": "n4", "error": "n9" } },
    { "id": "n4", "kind": "condition", "title": "¿Cliente encontrado?", "match": "all", "rules": [ { "variable": "cliente", "operator": "isNotEmpty" } ], "outputs": { "yes": "n5", "no": "n8" } },
    { "id": "n5", "kind": "list", "title": "¿Cuál equipo?", "text": "Elige el equipo que necesita servicio.", "buttonLabel": "Ver equipos", "options": { "kind": "dynamic", "collection": "equipos", "idField": "id", "titleField": "referenceCode", "descriptionField": "address", "extraOption": { "id": "other", "title": "Otra dirección" } }, "saveTo": "equipo", "fallback": "repeat", "outputs": { "chosen": "n6", "extra": "n10", "tooMany": "n9", "other": null } },
    { "id": "n6", "kind": "buttons", "title": "¿Qué necesitas?", "text": "¿Qué necesitas para tu equipo?", "buttons": [ { "id": "tech", "label": "Servicio técnico" }, { "id": "maint", "label": "Mantenimiento" } ], "saveTo": "motivo", "fallback": "repeat", "outputs": { "tech": "n7", "maint": "n11", "other": null } },
    { "id": "n7", "kind": "attachment", "title": "Foto de la factura", "text": "Envíanos una foto de la factura.", "accept": "any", "saveTo": "factura", "outputs": { "received": "n12", "invalid": null } },
    { "id": "n8", "kind": "message", "title": "No registrado", "text": "No estás registrado. Regístrate aquí y te atendemos.", "urlButton": { "label": "Registrarme", "url": "https://www.example.com/registro" }, "outputs": { "next": "n11" } },
    { "id": "n9", "kind": "handoff", "title": "Pasar a un asesor", "text": "Te paso con un asesor." },
    { "id": "n10", "kind": "openQuestion", "title": "Dirección nueva", "text": "¿Cuál es la dirección?", "saveTo": "direccion", "validation": { "kind": "none" }, "outputs": { "answered": "n6", "invalid": null } },
    { "id": "n11", "kind": "handoff", "title": "Asesor de mantenimiento", "text": "Un asesor te escribe en un momento." },
    { "id": "n12", "kind": "http", "title": "Crear orden", "connectionId": "22222222-2222-2222-2222-222222222222", "method": "POST", "path": "/service-orders", "body": { "kind": "json", "template": "{ \"customerId\": {cliente.id}, \"address\": \"{direccion}\" }" }, "outputs": { "ok": "n13", "error": "n9" } },
    { "id": "n13", "kind": "resolve", "title": "Listo", "text": "Tu orden es la {orden.id}." }
  ]
}
